{
  "name": "agent-payment-firewall",
  "version": "0.1.0",
  "description": "Formally verified payment firewall for AI shopping agents, built on PayPal Agent Toolkit and Z3.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "mcp:config": "tsx --env-file-if-exists=.env src/mcp/printConfig.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^4.3.19",
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "z3-solver": "^4.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^1.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
